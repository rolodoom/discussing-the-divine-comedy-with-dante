---
import { Menu, X } from '@lucide/astro'

const isHome = Astro.url.pathname === '/'

const links = [
  { href: '/', label: 'Inicio' },
  { href: '/artists', label: 'Artistas' },
  { href: '/about', label: 'Acerca de' }
]
---

<header class="fixed top-0 left-0 z-50 w-full">
  <nav class="flex items-center justify-between bg-slate-600 px-4 py-2 shadow-md dark:bg-slate-950">
    <a
      href="/"
      class="font-display text-lg font-bold text-white uppercase transition-all duration-300 ease-in-out hover:text-slate-300 dark:text-slate-100 hover:dark:text-slate-500"
    >
      Discussing the Divine Comedy with Dante
    </a>

    <button
      id="menu-toggle"
      type="button"
      aria-label="Abrir menú"
      class="flex size-10 items-center justify-center rounded-lg text-white hover:bg-slate-300 dark:text-slate-100 dark:hover:bg-slate-800"
    >
      <Menu class="size-6" data-icon="open" />
      <X class="hidden size-6" data-icon="close" />
    </button>
  </nav>
</header>

<div
  id="mobile-menu"
  class="pointer-events-none fixed inset-0 z-40 flex flex-col items-center justify-center gap-8 bg-white opacity-0 transition-opacity duration-300 ease-out dark:bg-slate-900"
>
  {links.map((link) => (
    <a href={link.href} class="text-2xl font-medium text-slate-900 dark:text-slate-100">
      {link.label}
    </a>
  ))}
</div>

<script>
  const toggle = document.getElementById('menu-toggle')
  const menu = document.getElementById('mobile-menu')
  const iconOpen = toggle?.querySelector<HTMLElement>("[data-icon='open']")
  const iconClose = toggle?.querySelector<HTMLElement>("[data-icon='close']")

  function setMenu(open: boolean): void {
    menu?.classList.toggle('opacity-0', !open)
    menu?.classList.toggle('pointer-events-none', !open)
    iconOpen?.classList.toggle('hidden', open)
    iconClose?.classList.toggle('hidden', !open)
    toggle?.setAttribute('aria-expanded', String(open))
  }

  function isMenuClosed(): boolean {
    return menu?.classList.contains('opacity-0') ?? false
  }

  toggle?.addEventListener('click', () => {
    setMenu(isMenuClosed())
  })

  menu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      // Quitar la transición SOLO para este cierre
      menu?.classList.remove('transition-opacity')
      setMenu(false)

      // Restaurarla inmediatamente para el próximo uso
      menu?.classList.add('transition-opacity')
    })
  })

  window.addEventListener('pageshow', (event: PageTransitionEvent) => {
    if (event.persisted) setMenu(false)
  })
</script>
