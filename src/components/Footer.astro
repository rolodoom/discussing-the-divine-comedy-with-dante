---
import { Coffee, Heart } from '@lucide/astro'

const isHome = Astro.url.pathname === '/'
---

<footer
  class:list={[
    isHome
      ? 'my-6 px-4 text-center text-sm leading-6'
      : 'mt-12 mb-6 px-4 text-center text-sm leading-6'
  ]}
>
  Hecho con <Heart size={16} class="mx-1 mb-1 inline-block text-red-600" /> y mucho{' '}
  <Coffee size={16} class="mx-1 mb-1 inline-block text-yellow-700" /> Café por{' '}
  <a
    href="https://github.com/rolodoom"
    target="_blank"
    rel="noopener noreferrer"
    class="font-bold hover:text-slate-900 hover:underline hover:underline-offset-4 dark:hover:text-slate-100"
  >
    RoLoDoOm
  </a>
</footer>
