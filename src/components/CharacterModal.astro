---
import { characters } from '@/data/characters'
import CharacterCard from '@/components/CharacterCard.astro'
---

<dialog
  id="character-modal"
  class="m-auto w-[calc(100%-2rem)] max-w-lg rounded-2xl bg-white p-0 text-slate-900 shadow-2xl backdrop:bg-black/60 dark:bg-slate-800 dark:text-slate-100"
>
  <div class="relative p-6">
    <button
      id="close-character-modal"
      type="button"
      aria-label="Cerrar"
      class="absolute top-4 right-4 flex size-9 items-center justify-center rounded-full bg-slate-100 text-xl text-slate-600 hover:bg-slate-200 dark:bg-slate-700 dark:text-slate-300 dark:hover:bg-slate-600"
    >
      ×
    </button>

    <div id="character-modal-content"></div>
  </div>
</dialog>

{characters.map((character) => (
  <template id={`character-${character.id}`}>
    <CharacterCard character={character} />
  </template>
))}

<script>
  const modal = document.querySelector<HTMLDialogElement>('#character-modal')
  const content = document.querySelector<HTMLElement>('#character-modal-content')
  const closeButton = document.querySelector<HTMLButtonElement>('#close-character-modal')

  document.querySelectorAll<HTMLButtonElement>('[data-character-id]').forEach((button) => {
    button.addEventListener('click', () => {
      const id = button.dataset.characterId
      const template = document.querySelector<HTMLTemplateElement>(`#character-${id}`)

      if (!template || !modal || !content) return

      content.replaceChildren(template.content.cloneNode(true))
      modal.showModal()
    })
  })

  closeButton?.addEventListener('click', () => {
    modal?.close()
  })

  modal?.addEventListener('click', (event) => {
    if (event.target === modal) {
      modal.close()
    }
  })
</script>
