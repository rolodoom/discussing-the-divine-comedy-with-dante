---
import BaseHead from '@/components/BaseHead.astro'
import NavMenu from '@/components/NavMenu.astro'

const { title, description, image = '/images/cover.png' } = Astro.props
---

<html lang="en">
  <head>
    <BaseHead title={title} description={description} image={image} />
  </head>
  <body class="bg-white text-lg text-slate-900 dark:bg-slate-900 dark:text-slate-100">
    <NavMenu />
    <slot />
  </body>
</html>
